<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="merino"
        Arguments=""
        InstallLocation="C:\Program Files\LoneExile\Merino">
    </Installer>
    <PackageInformation
        PackageName="Merino"
        PackageDisplayName="Merino"
        PublisherName="CN=LoneExile"
        PublisherDisplayName="LoneExile"
        Version="0.1.0.0"
        PackageDescription="Menubar dashboard for herdr agents">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.loneexile.herdrtunnel"
                Description="Menubar dashboard for herdr agents"
                DisplayName="Merino"
                ExecutableName="merino"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Merino</DisplayName>
            <PublisherDisplayName>LoneExile</PublisherDisplayName>
            <Description>Menubar dashboard for herdr agents</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="merino.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
